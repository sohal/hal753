{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 0,
        "patch": 0
    },
    "include": [
        "CMakePresets/HiddenPresets.json"
    ],
    "configurePresets": [
        {

            "$comment": "****************************** cross compiler gcc on docker",
            "hidden": true,
            "name": "local-gnuarm14.3",
            "generator": "Ninja",
            "environment": {
                "COMPILER_ROOT_PATH": "$env{HOME}/gnuarm14.3"
            },
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/_deps/cmake_scripts-src/toolchains/arm_none_eabi_gcc.cmake"
            }

        },
        {
            "inherits": [
                "debug",
                "mcu",
                "local-gnuarm14.3",
                "board-nucleo-h753"
            ],
            "name": "nucleo-h753-hal-local-gnuarm14.3",
            "hidden": false,
            "displayName": "nucleo-h753 hal static lib with local arm gcc 14.3",
            "description": "nucleo-h753 hal static lib with local arm gcc 14.3 installation at ${HOME}/gnuarm14.3"
        }
    ],
    "buildPresets": [
        {
            "name": "nucleo-h753-hal-local-gnuarm14.3",
            "configurePreset": "nucleo-h753-hal-local-gnuarm14.3"
        }
    ]
}
