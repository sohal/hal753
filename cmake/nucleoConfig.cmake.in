@PACKAGE_INIT@

# Find and include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/nucleoTargets.cmake")

# Set compile definitions for all targets
set_target_properties(nucleo::nucleo-h753 PROPERTIES
    INTERFACE_COMPILE_DEFINITIONS "USE_HAL_DRIVER"
)

# Provide package variables
set(NUCLEO_FOUND TRUE)
set(NUCLEO_VERSION "@PROJECT_VERSION@")

# Cache variables for include directories
set(NUCLEO_HAL_INCLUDE_DIRS
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/nucleo"
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/stm32cubeh7"
    CACHE STRING "STM32H753 HAL include directories"
)

set(NUCLEO_QPC_INCLUDE_DIRS
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/qpc/include"
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/qpc/config"
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/qpc/port"
    CACHE STRING "QP/C framework include directories"
)

set(NUCLEO_INCLUDE_DIRS
    ${NUCLEO_HAL_INCLUDE_DIRS}
    ${NUCLEO_QPC_INCLUDE_DIRS}
    CACHE STRING "All Nucleo package include directories"
)

# Cache variables for library archives
set(NUCLEO_HAL_LIBRARY
    "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libnucleo-h753.a"
    CACHE FILEPATH "STM32H753 HAL static library"
)

set(NUCLEO_QPC_LIBRARY
    "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libqpc.a"
    CACHE FILEPATH "QP/C framework static library"
)

set(NUCLEO_LIBRARIES
    ${NUCLEO_HAL_LIBRARY}
    ${NUCLEO_QPC_LIBRARY}
    CACHE STRING "All Nucleo package libraries"
)

check_required_components(nucleo)
